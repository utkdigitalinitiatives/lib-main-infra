#cloud-config
# Cloud-init configuration for lib-main Drupal VMSS instances
# This configures database, storage, and runs Drupal site installation

write_files:
  # Drupal environment configuration (PHP)
  - path: /etc/drupal/environment.php
    permissions: '0640'
    owner: root:drupal
    content: |
      <?php
      /**
       * Drupal environment configuration.
       * Populated by cloud-init at boot time.
       */

      // Database configuration
      // Password is substituted at boot by /opt/fetch-secrets.sh (Key Vault).
      $databases['default']['default'] = [
        'database' => '${db_name}',
        'username' => '${db_user}',
        'password' => '__DB_PASSWORD__',
        'host' => '${db_host}',
        'port' => '5432',
        'driver' => 'pgsql',
        'prefix' => '',
      ];

      // --- TEMPORARY: D10 news migration source (Pantheon MySQL). Remove after migration. ---
      // Overrides the placeholder $databases['migrate'] declared in settings.php
      // (utkdigitalinitiatives/lib-main#132). Values are substituted at boot by
      // /opt/fetch-secrets.sh IF the 'migrate-pantheon-db' Key Vault secret exists;
      // if it doesn't, the __MIGRATE_DB_*__ placeholders remain (inert — the connection
      // is only ever opened by an explicit `drush migrate:*` run).
      $databases['migrate']['default'] = [
        'database'  => '__MIGRATE_DB_NAME__',
        'username'  => '__MIGRATE_DB_USER__',
        'password'  => '__MIGRATE_DB_PASS__',
        'host'      => '__MIGRATE_DB_HOST__',
        'port'      => '__MIGRATE_DB_PORT__',
        'driver'    => 'mysql',
        'namespace' => 'Drupal\\Core\\Database\\Driver\\mysql',
        'prefix'    => '',
      ];

      // Hash salt for security
      // Substituted at boot by /opt/fetch-secrets.sh (Key Vault).
      $settings['hash_salt'] = '__HASH_SALT__';

      // Trusted host patterns
      $settings['trusted_host_patterns'] = [
        '^localhost$',
        '^127\.0\.0\.1$',
%{ if lb_fqdn != null ~}
        '^' . preg_quote('${lb_fqdn}', '/') . '$',
%{ endif ~}
%{ if domain_name != null ~}
        '^' . preg_quote('${domain_name}', '/') . '$',
%{ endif ~}
      ];

      // Key module: inject storage key into Key entity.
      // Substituted at boot by /opt/fetch-secrets.sh (Key Vault).
      $config['key.key.azure_blob_key']['key_provider'] = 'config';
      $config['key.key.azure_blob_key']['key_provider_settings']['key_value'] = '__STORAGE_KEY__';

      // Azure Blob File System configuration
      $config['az_blob_fs.settings']['az_blob_account_name'] = '${storage_account}';
      $config['az_blob_fs.settings']['az_blob_account_key_name'] = 'azure_blob_key';
      $config['az_blob_fs.settings']['az_blob_container_name'] = '${storage_container}';
      $config['az_blob_fs.settings']['az_blob_protocol'] = 'https';
%{ if domain_name != null ~}
      $config['az_blob_fs.settings']['az_blob_cdn_host_name'] = '${domain_name}';
%{ endif ~}

      // Default file scheme
      $settings['file_default_scheme'] = 'azblob';

      // Reverse proxy settings for Azure Load Balancer
      $settings['reverse_proxy'] = TRUE;
      $settings['reverse_proxy_addresses'] = ['127.0.0.1', '168.63.129.16'];
      $settings['reverse_proxy_trusted_headers'] =
        \Symfony\Component\HttpFoundation\Request::HEADER_X_FORWARDED_FOR |
        \Symfony\Component\HttpFoundation\Request::HEADER_X_FORWARDED_HOST |
        \Symfony\Component\HttpFoundation\Request::HEADER_X_FORWARDED_PORT |
        \Symfony\Component\HttpFoundation\Request::HEADER_X_FORWARDED_PROTO;

  # Secrets bootstrap: fetches Key Vault secrets via VMSS managed identity,
  # substitutes placeholders in environment.php, and writes /etc/drupal/secrets.env
  # for downstream shell scripts (drush, etc.).
  - path: /opt/fetch-secrets.sh
    permissions: '0750'
    owner: root:root
    content: |
      #!/bin/bash
      set -euo pipefail

      KV_NAME="${kv_name}"
      ENV_NAME="${env_name}"
      HASH_SALT_SECRET="${hash_salt_secret_name}"
      STORAGE_KEY_SECRET="${storage_key_secret_name}"
      PRIVATE_STORAGE_KEY_SECRET="${private_files_key_secret_name}"
      ADMIN_PASSWORD_SECRET="${drupal_admin_password_secret_name}"
      ADMIN_PASSWORD_FILE="/etc/drupal/admin-password"
      ENV_PHP="/etc/drupal/environment.php"
      SECRETS_ENV="/etc/drupal/secrets.env"
      LOG_FILE="/var/log/drupal-init.log"

      log() {
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [fetch-secrets] $1" | tee -a "$LOG_FILE"
      }

      # python3 stderr is silenced: during RBAC propagation the response
      # lacks the expected key and prints a KeyError traceback that log
      # scanners flag as an error. Real failures still surface via the
      # terminal "ERROR: could not fetch required secrets" log below.
      get_token() {
        curl -s -H "Metadata: true" \
          "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https://vault.azure.net" \
          | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])" 2>/dev/null
      }

      fetch_secret() {
        local name="$1"
        local token="$2"
        curl -s -H "Authorization: Bearer $token" \
          "https://$KV_NAME.vault.azure.net/secrets/$name?api-version=7.4" \
          | python3 -c "import sys,json; print(json.load(sys.stdin)['value'])" 2>/dev/null
      }

      # Retry for ~3 minutes: RBAC role propagation can lag 1-2 minutes after
      # VMSS boot, especially on first apply when the role assignment itself
      # is created in parallel with the VMSS instance.
      DB_PASSWORD=""
      HASH_SALT=""
      STORAGE_KEY=""
      PRIVATE_STORAGE_KEY=""
      ADMIN_PASSWORD=""
      for attempt in $(seq 1 18); do
        TOKEN=$(get_token || true)
        if [ -n "$TOKEN" ]; then
          DB_PASSWORD=$(fetch_secret "$ENV_NAME-db-admin-password" "$TOKEN" || true)
          HASH_SALT=$(fetch_secret "$HASH_SALT_SECRET" "$TOKEN" || true)
          STORAGE_KEY=$(fetch_secret "$STORAGE_KEY_SECRET" "$TOKEN" || true)
          # Best-effort: the private-files mount is non-fatal by design, so this
          # secret is not part of the required set gating the loop below.
          PRIVATE_STORAGE_KEY=$(fetch_secret "$PRIVATE_STORAGE_KEY_SECRET" "$TOKEN" || true)
          # Best-effort: /opt/drupal-init.sh needs it only to install into an
          # empty database, and refuses to install without it.
          ADMIN_PASSWORD=$(fetch_secret "$ADMIN_PASSWORD_SECRET" "$TOKEN" || true)
          [ -n "$DB_PASSWORD" ] && [ -n "$HASH_SALT" ] && [ -n "$STORAGE_KEY" ] && break
        fi
        log "Secret fetch attempt $attempt incomplete; retrying in 10s..."
        sleep 10
      done

      if [ -z "$DB_PASSWORD" ] || [ -z "$HASH_SALT" ] || [ -z "$STORAGE_KEY" ]; then
        log "ERROR: could not fetch required secrets from $KV_NAME"
        exit 1
      fi

      # Substitute placeholders in environment.php. Use python rather than sed
      # so '/' '&' '|' in values don't need escaping. Each value lands inside a
      # single-quoted PHP string, so \ and ' are escaped for PHP.
      DB_PASSWORD="$DB_PASSWORD" HASH_SALT="$HASH_SALT" STORAGE_KEY="$STORAGE_KEY" \
        python3 - "$ENV_PHP" <<'PYEOF'
      import os, sys
      def php(value):
          return value.replace('\\', '\\\\').replace("'", "\\'")
      path = sys.argv[1]
      with open(path) as f:
          content = f.read()
      content = content.replace('__DB_PASSWORD__', php(os.environ['DB_PASSWORD']))
      content = content.replace('__HASH_SALT__', php(os.environ['HASH_SALT']))
      content = content.replace('__STORAGE_KEY__', php(os.environ['STORAGE_KEY']))
      with open(path, 'w') as f:
          f.write(content)
      PYEOF

      # %q quotes each value so `source` reads it back verbatim, whatever
      # characters it holds.
      umask 077
      {
        printf 'DB_PASSWORD=%q\n' "$DB_PASSWORD"
        printf 'PRIVATE_STORAGE_KEY=%q\n' "$PRIVATE_STORAGE_KEY"
      } > "$SECRETS_ENV"
      chmod 640 "$SECRETS_ENV"
      chown root:drupal "$SECRETS_ENV"

      # Drupal admin password, root-only. Read only by the install branch of
      # /opt/drupal-init.sh, so it stays out of custom_data.
      rm -f "$ADMIN_PASSWORD_FILE"
      if [ -n "$ADMIN_PASSWORD" ]; then
        printf '%s' "$ADMIN_PASSWORD" > "$ADMIN_PASSWORD_FILE"
      fi

      # --- TEMPORARY: Pantheon migration source creds (OPTIONAL — must never block boot) ---
      # Only substitutes if the 'migrate-pantheon-db' secret exists in KV. A missing or
      # failed fetch is NOT an error here. Secret value is JSON:
      #   {"database":..,"username":..,"password":..,"host":..,"port":..}
      MIGRATE_TOKEN=$(get_token || true)
      MIGRATE_JSON=""
      if [ -n "$MIGRATE_TOKEN" ]; then
        MIGRATE_JSON=$(fetch_secret "migrate-pantheon-db" "$MIGRATE_TOKEN" || true)
      fi
      if [ -n "$MIGRATE_JSON" ]; then
        # Wrapped in if/then so a malformed secret logs a warning instead of
        # aborting the VMSS boot under `set -e` (prod boot must never be blocked
        # by this optional migration wiring).
        if MIGRATE_JSON="$MIGRATE_JSON" python3 - "$ENV_PHP" 2>/dev/null <<'PYEOF'
      import os, sys, json
      def php(value):
          return value.replace('\\', '\\\\').replace("'", "\\'")
      path = sys.argv[1]
      creds = json.loads(os.environ['MIGRATE_JSON'])
      with open(path) as f:
          content = f.read()
      for token, field in [('NAME', 'database'), ('USER', 'username'), ('PASS', 'password'), ('HOST', 'host'), ('PORT', 'port')]:
          content = content.replace('__MIGRATE_DB_' + token + '__', php(str(creds[field])))
      with open(path, 'w') as f:
          f.write(content)
      PYEOF
        then
          log "Migrate (Pantheon) source DB credentials injected"
        else
          log "WARNING: migrate-pantheon-db present but could not be applied (malformed JSON?); continuing boot"
        fi
      else
        log "No migrate-pantheon-db secret; migration source not configured (normal outside migration)"
      fi

      log "Secrets bootstrap complete"

  # Drupal installation script
  - path: /opt/drupal-init.sh
    permissions: '0750'
    owner: root:root
    content: |
      #!/bin/bash
      # pipefail: drush output goes through tee, which would otherwise hide a
      # failed drush from set -e.
      set -eo pipefail

      # Sourced from /opt/fetch-secrets.sh (Key Vault MI).
      # shellcheck disable=SC1091
      source /etc/drupal/secrets.env

      DRUPAL_ROOT="/var/www/drupal"
      DRUSH="$DRUPAL_ROOT/vendor/bin/drush"
      LOG_FILE="/var/log/drupal-init.log"
      LOCK_FILE="/var/run/drupal-init.lock"

      # Prevent concurrent runs
      exec 200>"$LOCK_FILE"
      flock -n 200 || { echo "Another instance is running"; exit 0; }

      log() {
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
      }

      log "Starting Drupal initialization..."

      # Fixed site UUID for config sync (set via Terraform)
      SITE_UUID="${drupal_site_uuid}"
      CONFIG_SYNC_DIR="$DRUPAL_ROOT/config"

      # Install or update? Ask the database, not Drupal. `drush status` says
      # "Successful" only after a full bootstrap, so a production DB that Drupal
      # could not boot (a PHP fatal in new code, a stale cached container, a
      # half-finished import) used to fall through to site:install, which drops
      # every table first. sql:query needs only the configuration bootstrap.
      # pg_tables lists every table, whatever this user's grants. If the count
      # cannot be read, stop: neither branch is safe to guess.
      cd "$DRUPAL_ROOT"
      if ! TABLES=$(sudo -u drupal $DRUSH sql:query "SELECT count(*) FROM pg_catalog.pg_tables WHERE schemaname = 'public'" 2>>"$LOG_FILE"); then
        log "ERROR: cannot query the database; refusing to install or update"
        exit 1
      fi
      TABLES=$(echo "$TABLES" | tr -d '[:space:]')
      if ! [[ "$TABLES" =~ ^[0-9]+$ ]]; then
        log "ERROR: unexpected table count '$TABLES'; refusing to install or update"
        exit 1
      fi

      if [ "$TABLES" -gt 0 ]; then
        log "Database has $TABLES tables; Drupal already installed, running updates..."
        if ! sudo -u drupal $DRUSH updatedb -y 2>&1 | tee -a "$LOG_FILE"; then
          log "ERROR: updatedb failed"
          exit 1
        fi

        # Clean up orphaned s3fs module references (s3fs → az_blob_fs migration).
        # If the DB was synced from an environment where s3fs was still enabled,
        # drush config:import would fail trying to uninstall a module whose code
        # has already been removed from the codebase. Force-remove the references
        # directly in the active config store so config:import can proceed. This
        # block is idempotent: once the upstream DB no longer has s3fs, it is a
        # no-op and can eventually be deleted.
        log "Cleaning up orphaned s3fs module references (if any)..."
        sudo -u drupal $DRUSH php:eval '
          $editable = \Drupal::configFactory()->getEditable("core.extension");
          $modules = $editable->get("module") ?: [];
          if (isset($modules["s3fs"])) {
            unset($modules["s3fs"]);
            $editable->set("module", $modules)->save();
            echo "Removed s3fs from core.extension active config\n";
          }
          \Drupal::keyValue("system.schema")->delete("s3fs");
          foreach (\Drupal::configFactory()->listAll("s3fs.") as $name) {
            \Drupal::configFactory()->getEditable($name)->delete();
            echo "Deleted $name\n";
          }
        ' 2>&1 | tee -a "$LOG_FILE" || true
        sudo -u drupal $DRUSH cache:rebuild 2>&1 | tee -a "$LOG_FILE" || true

        # Import config if config directory has files
        if [ -f "$CONFIG_SYNC_DIR/system.site.yml" ]; then
          log "Config sync directory has config, importing..."
          # drush exits 0 on "no changes", so a failure is a real failure (a
          # veto, or a partial import). Carry on so the cache:rebuild below
          # still runs.
          sudo -u drupal $DRUSH config:import -y 2>&1 | tee -a "$LOG_FILE" || {
            log "ERROR: config:import failed; active config may not match the code. Continuing."
          }
        else
          log "No config in sync directory, skipping import"
        fi

        sudo -u drupal $DRUSH cache:rebuild 2>&1 | tee -a "$LOG_FILE" || true
        log "Updates complete"
      else
        # From /opt/fetch-secrets.sh (Key Vault), so it stays out of custom_data.
        ADMIN_PASSWORD_FILE="/etc/drupal/admin-password"
        if [ ! -s "$ADMIN_PASSWORD_FILE" ]; then
          log "ERROR: the database is empty but Key Vault gave no admin password; refusing to install"
          exit 1
        fi
        # URL-encode the password: @ : / # % would otherwise break the db-url.
        DB_PASSWORD_URL=$(DB_PASSWORD="$DB_PASSWORD" python3 -c 'import os, urllib.parse; print(urllib.parse.quote(os.environ["DB_PASSWORD"], safe=""))')
        log "Database has no tables; installing Drupal..."
        sudo -u drupal $DRUSH site:install standard \
          --db-url="pgsql://${db_user}:$DB_PASSWORD_URL@${db_host}:5432/${db_name}" \
          --site-name="lib-main" \
          --account-name=admin \
          --account-pass="$(cat "$ADMIN_PASSWORD_FILE")" \
          --account-mail="admin@example.com" \
          -y 2>&1 | tee -a "$LOG_FILE"

        # Set fixed site UUID for config sync compatibility
        log "Setting site UUID to $SITE_UUID..."
        sudo -u drupal $DRUSH config:set system.site uuid "$SITE_UUID" -y 2>&1 | tee -a "$LOG_FILE"

        log "Enabling Azure Blob FS module..."
        sudo -u drupal $DRUSH en key az_blob_fs -y 2>&1 | tee -a "$LOG_FILE" || true

        log "Rebuilding cache..."
        sudo -u drupal $DRUSH cache:rebuild 2>&1 | tee -a "$LOG_FILE"

        log "Drupal installation complete"
      fi

      log "Drupal initialization finished"

  # Mount the Azure Files share backing Drupal's private:// filesystem over
  # /var/www/drupal/private (the path baked into settings.php as file_private_path).
  # This replaces the ephemeral per-instance local dir with durable, shared storage so
  # editor-only webform/media uploads survive VMSS reimages and stay consistent across
  # rolling-deploy surge instances. Non-fatal: on any failure the site still boots and
  # private:// falls back to the empty local dir (loudly logged for monitoring).
  - path: /opt/mount-private-files.sh
    permissions: '0750'
    owner: root:root
    content: |
      #!/bin/bash
      set -uo pipefail

      STORAGE_ACCOUNT="${private_files_account}"
      SHARE_NAME="${private_files_share}"
      MOUNT_POINT="/var/www/drupal/private"
      CRED_DIR="/etc/smbcredentials"
      CRED_FILE="$CRED_DIR/$STORAGE_ACCOUNT.cred"
      LOG_FILE="/var/log/drupal-init.log"

      log() {
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [mount-private] $1" | tee -a "$LOG_FILE"
      }

      # PRIVATE_STORAGE_KEY (dedicated private-files account, not the media account)
      # was persisted to secrets.env by /opt/fetch-secrets.sh (Key Vault MI).
      # shellcheck disable=SC1091
      source /etc/drupal/secrets.env
      if [ -z "$${PRIVATE_STORAGE_KEY:-}" ]; then
        log "ERROR: PRIVATE_STORAGE_KEY unavailable; skipping mount. private:// falls back to ephemeral local dir."
        exit 0
      fi

      # cifs-utils is baked into newer base images; install on demand for older ones.
      if ! rpm -q cifs-utils >/dev/null 2>&1; then
        log "Installing cifs-utils..."
        dnf install -y cifs-utils 2>&1 | tail -1 | tee -a "$LOG_FILE" || {
          log "ERROR: cifs-utils install failed; skipping private files mount."
          exit 0
        }
      fi

      # Idempotent: already mounted (e.g. re-run) → nothing to do.
      if mountpoint -q "$MOUNT_POINT"; then
        log "$MOUNT_POINT already mounted; nothing to do."
        exit 0
      fi

      install -d -m 0770 -o drupal -g drupal "$MOUNT_POINT"

      umask 077
      mkdir -p "$CRED_DIR"
      cat > "$CRED_FILE" <<CREDEOF
      username=$STORAGE_ACCOUNT
      password=$PRIVATE_STORAGE_KEY
      CREDEOF
      chmod 600 "$CRED_FILE"

      DRUPAL_UID=$(id -u drupal)
      DRUPAL_GID=$(id -g drupal)

      # Persist in fstab so the mount also survives an in-place reboot (host
      # maintenance), not just reimages where cloud-init re-runs. _netdev + nofail
      # keep boot from hanging/failing if the share is briefly unreachable.
      # SELinux is enforcing and CIFS takes a single mount-wide label, so force the
      # same context Apache/php-fpm use for the web root (httpd_sys_rw_content_t) —
      # otherwise php-fpm cannot read/write the mounted private files.
      MOUNT_OPTS="credentials=$CRED_FILE,vers=3.1.1,uid=$DRUPAL_UID,gid=$DRUPAL_GID,dir_mode=0770,file_mode=0660,serverino,nosharesock,actimeo=30,mfsymlinks,_netdev,nofail,context=system_u:object_r:httpd_sys_rw_content_t:s0"
      FSTAB_LINE="//$STORAGE_ACCOUNT.file.core.windows.net/$SHARE_NAME $MOUNT_POINT cifs $MOUNT_OPTS 0 0"
      if ! grep -qF " $MOUNT_POINT cifs " /etc/fstab 2>/dev/null; then
        echo "$FSTAB_LINE" >> /etc/fstab
      fi

      if mount "$MOUNT_POINT" 2>&1 | tee -a "$LOG_FILE"; then
        log "Mounted //$STORAGE_ACCOUNT.file.core.windows.net/$SHARE_NAME at $MOUNT_POINT"
      else
        log "ERROR: failed to mount private files share; continuing with ephemeral local dir."
        exit 0
      fi

%{ if enable_https && domain_name != null ~}
  # TLS setup script (Let's Encrypt with blob-backed cert persistence)
  - path: /opt/tls-setup.sh
    permissions: '0750'
    owner: root:root
    content: |
      #!/bin/bash
      # pipefail: certbot output goes through tee, which would otherwise hide a
      # failed certbot from set -e.
      set -eo pipefail

      DOMAIN="${domain_name}"
      STORAGE_ACCOUNT="${storage_account}"
      CERT_CONTAINER="tls-certs"
      CERT_DIR="/etc/pki/tls"
      CERT_FILE="$CERT_DIR/certs/letsencrypt-fullchain.pem"
      KEY_FILE="$CERT_DIR/private/letsencrypt-privkey.pem"
      LOG_FILE="/var/log/drupal-init.log"

      log() {
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [tls-setup] $1" | tee -a "$LOG_FILE"
      }

      log "Starting TLS setup for $DOMAIN..."

      # Get Azure managed identity token via IMDS
      get_token() {
        curl -s -H "Metadata: true" \
          "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https://storage.azure.com/" \
          | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])"
      }

      # Download a blob to a file. Returns 0 on 200, 2 when the blob does not
      # exist (404), and 1 on any other failure.
      download_blob() {
        local blob_path="$1"
        local dest="$2"
        local token http_code
        token=$(get_token 2>/dev/null) || return 1
        http_code=$(curl -s -o "$dest" -w "%%{http_code}" \
          -H "Authorization: Bearer $token" \
          -H "x-ms-version: 2020-10-02" \
          "https://$STORAGE_ACCOUNT.blob.core.windows.net/$CERT_CONTAINER/$blob_path") || return 1
        [ "$http_code" = "200" ] && return 0
        [ "$http_code" = "404" ] && return 2
        return 1
      }

      # Upload a file to Azure Storage. Fails unless Azure answers 201 Created.
      upload_blob() {
        local src="$1"
        local blob_path="$2"
        local token http_code
        token=$(get_token 2>/dev/null) || return 1
        http_code=$(curl -s -o /dev/null -w "%%{http_code}" -X PUT \
          -H "Authorization: Bearer $token" \
          -H "x-ms-version: 2020-10-02" \
          -H "x-ms-blob-type: BlockBlob" \
          -H "Content-Type: application/x-pem-file" \
          --data-binary "@$src" \
          "https://$STORAGE_ACCOUNT.blob.core.windows.net/$CERT_CONTAINER/$blob_path") || return 1
        [ "$http_code" = "201" ]
      }

      CERT_VALID=false

      # Try to download existing cert from blob storage. Both files go to a
      # temp dir first and are installed only as a valid pair, so an error
      # body never replaces the cert or key Apache is using. A 404 means there
      # is no cert yet. Any other failure (IMDS, RBAC lag, a storage hiccup) is
      # retried, so it does not cost a new Let's Encrypt issuance (5 duplicate
      # certs per week).
      log "Checking for existing certificate in blob storage..."
      TMP_DIR=$(mktemp -d)
      trap 'rm -rf "$TMP_DIR"' EXIT
      FETCHED=false
      for attempt in 1 2 3 4 5 6; do
        rc=0
        { download_blob "$DOMAIN/fullchain.pem" "$TMP_DIR/fullchain.pem" && \
          download_blob "$DOMAIN/privkey.pem" "$TMP_DIR/privkey.pem"; } || rc=$?
        if [ "$rc" -eq 0 ]; then
          FETCHED=true
          break
        fi
        [ "$rc" -eq 2 ] && break
        log "Certificate download attempt $attempt failed; retrying in 10s..."
        sleep 10
      done
      if [ "$FETCHED" = true ]; then
        # Validate cert is not expired/expiring within 7 days
        if openssl x509 -checkend 604800 -noout -in "$TMP_DIR/fullchain.pem" 2>/dev/null; then
          # install, not mv: a new file takes the SELinux label of its target
          # directory, and Apache cannot read a file labelled for /tmp.
          install -m 644 "$TMP_DIR/fullchain.pem" "$CERT_FILE"
          install -m 600 "$TMP_DIR/privkey.pem" "$KEY_FILE"
          log "Valid certificate found in blob storage"
          CERT_VALID=true
        else
          log "Certificate from blob storage is expired or expiring soon"
        fi
      else
        log "No certificate found in blob storage"
      fi

      # Issue new cert with certbot if needed
      if [ "$CERT_VALID" = false ]; then
        log "Installing certbot..."
        dnf install -y certbot 2>&1 | tail -1 | tee -a "$LOG_FILE"

        log "Requesting certificate from Let's Encrypt..."
        if ! certbot certonly --webroot \
          -w /var/www/drupal/web \
          -d "$DOMAIN" \
          --register-unsafely-without-email \
          --agree-tos \
          --non-interactive 2>&1 | tee -a "$LOG_FILE"; then
          log "ERROR: certbot failed; no certificate for $DOMAIN"
          exit 1
        fi

        # Copy certbot certs to standard location
        cp "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" "$CERT_FILE"
        cp "/etc/letsencrypt/live/$DOMAIN/privkey.pem" "$KEY_FILE"
        chmod 644 "$CERT_FILE"
        chmod 600 "$KEY_FILE"

        # Upload to blob storage for other instances
        log "Uploading certificate to blob storage..."
        if upload_blob "$CERT_FILE" "$DOMAIN/fullchain.pem" && \
           upload_blob "$KEY_FILE" "$DOMAIN/privkey.pem"; then
          log "Certificate uploaded to blob storage"
        else
          log "ERROR: certificate upload to blob storage failed; other instances will request their own"
        fi

        CERT_VALID=true
      fi

      if [ "$CERT_VALID" = true ]; then
        # Write Apache HTTPS vhost
        cat > /etc/httpd/conf.d/ssl-letsencrypt.conf <<SSLEOF
      Listen 443 https
      <VirtualHost *:443>
          SSLEngine on
          SSLCertificateFile $CERT_FILE
          SSLCertificateKeyFile $KEY_FILE

          SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
          SSLCipherSuite ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
          SSLHonorCipherOrder off

          DocumentRoot /var/www/drupal/web

          <Directory /var/www/drupal/web>
              Options -Indexes +FollowSymLinks
              AllowOverride All
              Require all granted
              RewriteEngine On
              RewriteBase /
              RewriteCond %%{REQUEST_FILENAME} !-f
              RewriteCond %%{REQUEST_FILENAME} !-d
              RewriteRule ^ index.php [L]
          </Directory>

          <FilesMatch \.php$>
              SetHandler "proxy:unix:/run/php-fpm/drupal.sock|fcgi://localhost"
          </FilesMatch>

          <Location /health>
              SetHandler none
              Require all granted
          </Location>

          # Reverse proxy for Azure Blob Storage files (private container, SAS auth)
          SSLProxyEngine On
          RewriteEngine On
          RewriteCond %%{REQUEST_URI} ^/drupal-media/
          RewriteRule ^/drupal-media/(.*)$ https://${storage_account}.blob.core.windows.net/drupal-media/\$1${storage_sas_token} [P,L,NE,E=proxy-nocanon:1]

          Header always set X-Frame-Options "SAMEORIGIN"
          Header always set X-Content-Type-Options "nosniff"
          # Ramping up: 300 through go-live, one day now, a year next.
          Header always set Strict-Transport-Security "max-age=86400"

          ErrorLog /var/log/httpd/drupal-ssl-error.log
          CustomLog /var/log/httpd/drupal-ssl-access.log combined
          ProxyTimeout 300
      </VirtualHost>
      SSLEOF

        # Replace HTTP vhost with redirect (exempt /health and ACME challenge)
        cat > /etc/httpd/conf.d/drupal.conf <<HTTPEOF
      <VirtualHost *:80>
          RewriteEngine On
          RewriteCond %%{REQUEST_URI} !^/health
          RewriteCond %%{REQUEST_URI} !^/\.well-known/acme-challenge/
          RewriteRule ^(.*)$ https://%%{HTTP_HOST}\$1 [R=301,L]

          <Location /health>
              SetHandler none
              Require all granted
          </Location>

          # Allow ACME challenges for cert renewal
          DocumentRoot /var/www/drupal/web
          <Directory /var/www/drupal/web/.well-known>
              Require all granted
          </Directory>
      </VirtualHost>
      HTTPEOF

        log "Apache HTTPS configuration written"

        # Set up cert renewal
        if [ -d "/etc/letsencrypt/live/$DOMAIN" ]; then
          # Certbot issued the cert — use certbot renewal
          cat > /etc/letsencrypt/renewal-hooks/deploy/01-update-and-upload.sh <<'RENEWEOF'
      #!/bin/bash
      # RENEWED_LINEAGE is the live/ directory; RENEWED_DOMAINS is a list.
      cp "$RENEWED_LINEAGE/fullchain.pem" /etc/pki/tls/certs/letsencrypt-fullchain.pem
      cp "$RENEWED_LINEAGE/privkey.pem" /etc/pki/tls/private/letsencrypt-privkey.pem
      chmod 644 /etc/pki/tls/certs/letsencrypt-fullchain.pem
      chmod 600 /etc/pki/tls/private/letsencrypt-privkey.pem
      systemctl restart httpd
      # Re-upload to blob storage
      /opt/tls-upload-cert.sh
      RENEWEOF
          chmod 750 /etc/letsencrypt/renewal-hooks/deploy/01-update-and-upload.sh

          # Upload helper script
          cat > /opt/tls-upload-cert.sh <<UPLOADEOF
      #!/bin/bash
      TOKEN=\$(curl -s -H "Metadata: true" \
        "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https://storage.azure.com/" \
        | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])")
      for FILE in fullchain.pem privkey.pem; do
        SRC="/etc/pki/tls/\$([ \$FILE = fullchain.pem ] && echo certs || echo private)/letsencrypt-\$FILE"
        curl -s -X PUT \
          -H "Authorization: Bearer \$TOKEN" \
          -H "x-ms-version: 2020-10-02" \
          -H "x-ms-blob-type: BlockBlob" \
          -H "Content-Type: application/x-pem-file" \
          --data-binary "@\$SRC" \
          "https://${storage_account}.blob.core.windows.net/tls-certs/${domain_name}/\$FILE"
      done
      UPLOADEOF
          chmod 750 /opt/tls-upload-cert.sh

          systemctl enable certbot-renew.timer
          systemctl start certbot-renew.timer
          log "Certbot renewal timer enabled"
        else
          # Cert came from blob — set up daily cron to check expiry and re-fetch.
          # tls-setup.sh only writes the new cert; Apache keeps serving the old
          # one until it reloads.
          cat > /etc/cron.daily/tls-check <<CRONEOF
      #!/bin/bash
      if ! openssl x509 -checkend 604800 -noout -in /etc/pki/tls/certs/letsencrypt-fullchain.pem 2>/dev/null; then
        /opt/tls-setup.sh && systemctl reload httpd
      fi
      CRONEOF
          chmod 750 /etc/cron.daily/tls-check
          log "Daily cert expiry check cron installed"
        fi
      fi

      log "TLS setup complete"
%{ endif ~}

runcmd:
  # Ensure directories have correct ownership
  - chown root:drupal /etc/drupal
  - chmod 750 /etc/drupal
  - chown root:drupal /etc/drupal/environment.php

  # Fetch secrets from Key Vault (must run before drupal-init.sh)
  - /opt/fetch-secrets.sh

  # Mount Azure Files share for durable private:// storage (needs STORAGE_KEY from above)
  - /opt/mount-private-files.sh

  # Run Drupal initialization
  - /opt/drupal-init.sh

%{ if enable_https && domain_name != null ~}
  # Configure TLS (Let's Encrypt)
  - /opt/tls-setup.sh
%{ endif ~}

  # Restart web services
  - systemctl restart php-fpm
  - systemctl restart httpd
